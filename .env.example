# --- Environment ---
# local turns on the API docs and allows wildcard CORS; anything else (use
# production on the server) turns the docs off, marks the session cookie
# Secure, and requires FRONTEND_ORIGIN.
ENVIRONMENT=local
NETWORK=mshsfootball-${ENVIRONMENT}
COMPOSE_PROFILES=local-db

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mshsfootball
# The database owner: schema setup and migrations. Required (compose refuses to start without it).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_RANDOM_PASSWORD
# Least-privilege roles (sql/app_roles.sql) the API and the pipelines connect
# as: read and write rows, nothing else. Set each user and password together
# (mshsfootball_api / mshsfootball_pipeline), after creating the roles; left
# blank, that service uses POSTGRES_USER. Passwords: openssl rand -hex 24
API_DB_USER=
API_DB_PASSWORD=
PIPELINE_DB_USER=
PIPELINE_DB_PASSWORD=

# --- API ---
API_PORT=8000
# CORS origin; required when ENVIRONMENT isn't local
FRONTEND_ORIGIN=https://yourdomain.com

# --- Prefect ---
PREFECT_API_URL=http://prefect-server:4200/api
PREFECT_LOGGING_LEVEL=INFO
PREFECT_PORT=4200
PYTHONPATH=/opt/prefect/flows/pipelines

# --- Nginx ---
NGINX_PORT=80

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_URL=https://res.cloudinary.com/${CLOUDINARY_CLOUD_NAME}/image/upload

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Client ID of the Auth0 Single Page Application the /moderate page signs in with
AUTH0_SPA_CLIENT_ID=

# --- Sessions ---
# HS256 signing key for the first-party session cookie (Prefect UI link).
# Generate with: openssl rand -hex 32
SESSION_SECRET_KEY=

# --- Cloudflare Turnstile (feedback form spam check; leave blank to turn off) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Daily moderation digest email (leave SMTP_HOST blank to turn off) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (default), ssl, or none; port 465 means ssl. none is refused unless ENVIRONMENT=local.
SMTP_SECURITY=
SMTP_FROM=
# Comma-separated recipients
DIGEST_TO=
SITE_URL=https://mshsfootball.com
