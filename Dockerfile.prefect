# Dockerfile for the Prefect worker that runs flows. Base images are pinned
# by digest so a rebuild gets exactly what was tested; Dependabot
# (.github/dependabot.yml) proposes updates. Keep the Prefect tag in step with
# prefect-server's image in docker-compose.yml.
FROM ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 AS uv

FROM prefecthq/prefect:2.20.27-python3.11@sha256:ff4e9b59e5e79721ed74fe45a7d129b9bd7cb7cdcf1ecfefa078e6afcb0d3aea

# System libs that Chromium needs (lean set)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 \
    libasound2 fonts-liberation fonts-dejavu-core ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Workdir for installing deps
WORKDIR /app

# Dependencies exactly as locked in uv.lock, every file checked against its
# hash, installed as plain site-packages (the project itself isn't installed:
# Prefect's to_deployment() must resolve flow files relative to CWD, and
# raises ValueError if the module resolves to site-packages). This layer only
# re-runs when pyproject.toml or uv.lock changes, not on every code edit.
COPY pyproject.toml uv.lock /app/
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv export --frozen --no-dev --no-emit-project -o /tmp/requirements.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt \
    && playwright install --with-deps chromium

# Copy flows as a backend/ subdir under CWD so that
# `from backend.xxx import yyy` resolves to local files, not site-packages.
COPY backend/ /opt/prefect/flows/pipelines/backend/
COPY sql/seeds/ /opt/prefect/flows/pipelines/sql/seeds/

# Configuration (and secrets) come from the container's environment at run
# time (docker-compose.yml), never from a file baked into an image layer.

# PYTHONPATH=/opt/prefect/flows/pipelines lets `from backend.xxx import`
# resolve to the local subdirectory.
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/prefect/flows/pipelines

WORKDIR /opt/prefect/flows/pipelines

CMD ["python", "backend/prefect/flows.py"]
