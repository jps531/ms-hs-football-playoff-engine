# Base images are pinned by digest so a rebuild gets exactly what was tested;
# Dependabot (.github/dependabot.yml) proposes updates.
FROM ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 AS uv

FROM python:3.11.17-slim@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce

WORKDIR /app

# Dependencies exactly as locked in uv.lock, every file checked against its
# hash. This layer only re-runs when pyproject.toml or uv.lock changes.
COPY pyproject.toml uv.lock /app/
RUN --mount=from=uv,source=/uv,target=/usr/local/bin/uv \
    uv export --frozen --no-dev --no-emit-project -o /tmp/requirements.txt \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY backend/ /app/backend/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Run as an unprivileged user: the API needs no root (port 8000, temp files in /tmp).
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin api
USER api

CMD ["fastapi", "run", "backend/api/main.py", "--host", "0.0.0.0", "--port", "8000"]
